# Copie para .env e ajuste. O .env NÃO vai para o git.
# Na Square Cloud, coloque o .env dentro do zip do deploy — ele é carregado sozinho.

# --- Painel web ---
# Em hospedagem (Square Cloud), o proxy só alcança o processo em 0.0.0.0:80.
PAINEL_HOST=0.0.0.0
PAINEL_PORT=80

# Senha do painel. TROQUE por algo longo e aleatório — o painel fica público.
PAINEL_TOKEN=troque-por-uma-senha-longa-e-aleatoria

# URL pública, usada pelo comando /painel
PAINEL_URL=https://harmito.squareweb.app

# --- Cobrança automática ---
# Deixe comentado enquanto estiver testando: assim o bot só SIMULA os envios.
# COBRANCA_REAL=1
COBRANCA_HORARIO=09:00
COBRANCA_MAX=20
